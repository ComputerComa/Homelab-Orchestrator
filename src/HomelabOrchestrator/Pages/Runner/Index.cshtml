@page
@using HomelabOrchestrator.Services.Ansible
@model IndexModel

<h2>Ansible Runner</h2>

@if (Model.Playbooks.Count == 0)
{
    <div class="banner banner-error">
        <h2>No playbooks found</h2>
        <p>Nothing was found under the configured Ansible playbooks directory.</p>
    </div>
}
else
{
    <form id="runner-form" method="post"
          hx-post
          hx-page="Index"
          hx-page-handler="Review"
          hx-target="#result"
          hx-swap="innerHTML"
          hx-indicator="#spinner"
          hx-disabled-elt="find button[type='submit']">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Form.PlaybookName" id="playbook-name-input" />
        <input type="hidden" asp-for="Form.Target" id="target-input" />

        <div class="runner-layout">
            <div class="runner-main">

                <div class="card">
                    <div class="card-header">
                        <h2>Playbook</h2>
                        <button type="button" id="open-playbook-modal" class="btn btn-secondary btn-small">Select playbook&hellip;</button>
                    </div>
                    <div id="playbook-summary">
                        <p class="muted">No playbook selected yet.</p>
                    </div>
                    <span asp-validation-for="Form.PlaybookName" class="field-error"></span>
                </div>

                <div class="card">
                    <div class="actions">
                        <button type="submit" id="run-submit" class="btn btn-primary" disabled>Review</button>
                        <span id="spinner" class="htmx-indicator">Working&hellip;</span>
                    </div>
                    <p id="confirm-hint" class="muted">Select a playbook and at least one container to continue.</p>
                </div>
                <span asp-validation-for="Form.Target" class="field-error"></span>
            </div>

            <div class="card runner-sidebar">
                <div class="card-header">
                    <h2>Target containers</h2>
                    <span id="selected-count" class="muted">0 selected</span>
                </div>

                <div class="field">
                    <label for="tag-filter">Filter by tag</label>
                    <div class="tag-filter-row">
                        <select id="tag-filter">
                            <option value="">All tags</option>
                            @foreach (var tag in Model.Targets.Tags)
                            {
                                <option value="@tag">@tag</option>
                            }
                        </select>
                        <button type="button" id="select-tagged" class="btn btn-secondary btn-small" disabled>Select</button>
                    </div>
                </div>

                <div class="quick-actions">
                    <button type="button" id="select-all-running" class="link-button">Select all running</button>
                    <button type="button" id="clear-selection" class="link-button">Clear</button>
                </div>

                @if (Model.Targets.RunningContainers.Count == 0)
                {
                    <p class="muted">No running containers found.</p>
                }
                else
                {
                    <div id="container-list" class="container-list">
                        @foreach (var container in Model.Targets.RunningContainers)
                        {
                            <label class="container-row" data-hostname="@container.Hostname" data-tags="@string.Join(",", container.Tags)">
                                <input type="checkbox" class="container-checkbox" value="@container.Hostname" />
                                <span class="status-dot" aria-hidden="true"></span>
                                <span class="container-hostname">@container.Hostname</span>
                                <span class="container-tags">
                                    @foreach (var tag in container.Tags)
                                    {
                                        <span class="tag-chip">@tag</span>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                    <p class="muted">Only currently running containers are listed.</p>
                }
            </div>
        </div>
    </form>
}

<div id="result"></div>

<dialog id="playbook-modal" aria-labelledby="playbook-modal-title">
    <div class="modal-header">
        <h2 id="playbook-modal-title">Select a playbook</h2>
        <button type="button" id="close-playbook-modal" class="link-button" aria-label="Close">&times;</button>
    </div>

    <div class="modal-search">
        <label for="playbook-search" class="visually-hidden">Search playbooks</label>
        <input type="search" id="playbook-search" placeholder="Search playbooks by name&hellip;" />
    </div>

    <div class="modal-body">
        <div id="playbook-list" class="playbook-list">
            @foreach (var detail in Model.PlaybookDetails)
            {
                <button type="button" class="playbook-row" data-name="@detail.Name" data-description="@detail.Description" data-steps="@string.Join("|", detail.Steps)">
                    <div class="playbook-row-name">@detail.Name</div>
                    <div class="playbook-row-desc">@detail.Description</div>
                </button>
            }
        </div>
        <div id="playbook-detail" class="playbook-detail">
            <p class="muted">Select a playbook from the list.</p>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" id="cancel-playbook-modal" class="btn btn-secondary">Cancel</button>
        <button type="button" id="use-playbook" class="btn btn-primary" disabled>Use this playbook</button>
    </div>
</dialog>

@if (Model.RecentRuns.Count > 0)
{
    <div class="card">
        <div class="card-header">
            <h2>Recent runs</h2>
            <a href="/Executions">View all</a>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Started</th>
                    <th>Playbook</th>
                    <th>Target</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in Model.RecentRuns)
                {
                    <tr>
                        <td><a href="/Executions/Details/@run.Id">@run.CreatedAtUtc.ToLocalTime().ToString("g")</a></td>
                        <td>@run.PlaybookName</td>
                        <td>@AnsibleRunTargetDescription.Describe(run.TargetKind, run.TargetValue)</td>
                        <td><span class="status-badge status-badge-@run.Stage.ToString().ToLowerInvariant()">@run.Stage</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<script src="~/js/runner.js" asp-append-version="true"></script>

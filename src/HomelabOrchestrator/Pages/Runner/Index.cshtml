@page
@using HomelabOrchestrator.Services.Ansible
@model IndexModel

<h2>Ansible Runner</h2>

@if (Model.Playbooks.Count == 0)
{
    <div class="banner banner-error">
        <h2>No playbooks found</h2>
        <p>Nothing was found under the configured Ansible playbooks directory.</p>
    </div>
}
else
{
    <form method="post"
          hx-post
          hx-page="Index"
          hx-page-handler="Review"
          hx-target="#result"
          hx-swap="innerHTML"
          hx-indicator="#spinner"
          hx-disabled-elt="find button[type='submit']">
        @Html.AntiForgeryToken()

        <div class="card">
            <h2>Run a playbook</h2>

            <div class="field">
                <label asp-for="Form.PlaybookName">Playbook</label>
                <select asp-for="Form.PlaybookName">
                    @foreach (var playbook in Model.Playbooks)
                    {
                        <option value="@playbook.Name">@playbook.Name</option>
                    }
                </select>
                <span asp-validation-for="Form.PlaybookName" class="field-error"></span>
            </div>

            <div class="field">
                <label>Target</label>

                <label class="target-option">
                    <input type="radio" asp-for="Form.Target" value="all" />
                    All running containers
                </label>

                @if (Model.Targets.RunningHostnames.Count > 0)
                {
                    <details class="target-group" open="@(Model.Form.Target.StartsWith("vm:", StringComparison.Ordinal))">
                        <summary>Specific container (@Model.Targets.RunningHostnames.Count)</summary>
                        @foreach (var hostname in Model.Targets.RunningHostnames)
                        {
                            <label class="target-option">
                                <input type="radio" asp-for="Form.Target" value="vm:@hostname" />
                                @hostname
                            </label>
                        }
                    </details>
                }

                @if (Model.Targets.Tags.Count > 0)
                {
                    <details class="target-group" open="@(Model.Form.Target.StartsWith("tag:", StringComparison.Ordinal))">
                        <summary>Tag group (@Model.Targets.Tags.Count)</summary>
                        @foreach (var tag in Model.Targets.Tags)
                        {
                            <label class="target-option">
                                <input type="radio" asp-for="Form.Target" value="tag:@tag" />
                                @tag
                            </label>
                        }
                    </details>
                }

                <span asp-validation-for="Form.Target" class="field-error"></span>
                <p class="muted">
                    Both lists are today's currently running containers — the run itself
                    re-checks this immediately before executing, since a container's state can
                    change between loading this page and confirming the run.
                </p>
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary">Review</button>
                <span id="spinner" class="htmx-indicator">Working&hellip;</span>
            </div>
        </div>
    </form>
}

<div id="result"></div>

@if (Model.RecentRuns.Count > 0)
{
    <div class="card">
        <div class="card-header">
            <h2>Recent runs</h2>
            <a href="/Executions">View all</a>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Started</th>
                    <th>Playbook</th>
                    <th>Target</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in Model.RecentRuns)
                {
                    <tr>
                        <td><a href="/Executions/Details/@run.Id">@run.CreatedAtUtc.ToLocalTime().ToString("g")</a></td>
                        <td>@run.PlaybookName</td>
                        <td>@AnsibleRunTargetDescription.Describe(run.TargetKind, run.TargetValue)</td>
                        <td><span class="status-badge status-badge-@run.Stage.ToString().ToLowerInvariant()">@run.Stage</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@page
@model ChangePasswordModel

<h2>Change password</h2>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="banner banner-success">
        <p>@Model.StatusMessage</p>
    </div>
}

<div asp-validation-summary="ModelOnly" class="field-error"></div>

<form method="post" class="card">
    @Html.AntiForgeryToken()

    <div class="field">
        <label asp-for="Form.CurrentPassword">Current password</label>
        <input asp-for="Form.CurrentPassword" type="password" autocomplete="current-password" />
        <span asp-validation-for="Form.CurrentPassword" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="Form.NewPassword">New password</label>
        <input asp-for="Form.NewPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="Form.NewPassword" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="Form.ConfirmPassword">Confirm new password</label>
        <input asp-for="Form.ConfirmPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="Form.ConfirmPassword" class="field-error"></span>
    </div>

    <div class="actions">
        <button type="submit" class="btn btn-primary">Change password</button>
    </div>
</form>

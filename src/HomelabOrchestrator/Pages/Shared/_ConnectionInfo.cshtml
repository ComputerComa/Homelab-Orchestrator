@model ClusterPlacement

<div id="connection-info" class="card">
    <div class="card-header">
        <h2>Cluster placement</h2>
        <button type="button"
                class="btn btn-secondary btn-small"
                hx-get
                hx-page="Index"
                hx-page-handler="Refresh"
                hx-target="#connection-info"
                hx-swap="outerHTML"
                hx-indicator="#spinner"
                hx-disabled-elt="this">
            Get another ID
        </button>
    </div>

    <dl class="fact-list">
        <dt>VMID</dt><dd>@Model.Vmid</dd>
        <dt>Address</dt><dd>@Model.IpAddress/@Model.Subnet</dd>
        <dt>Template</dt><dd>@Model.Template</dd>
        <dt>Node</dt><dd>@Model.Node</dd>
        <dt>Bridge</dt><dd>@Model.Bridge</dd>
        <dt>Gateway</dt><dd>@Model.Gateway</dd>
    </dl>

    <input type="hidden" name="Form.Vmid" value="@Model.Vmid" />
    <input type="hidden" name="Form.IpAddress" value="@Model.IpAddress" />
    <input type="hidden" name="Form.Template" value="@Model.Template" />
</div>

@model HomelabOrchestrator.Pages.SshKeys.SshKeyReviewViewModel

<div class="card">
    <h2>@Model.Title</h2>

    <div class="banner banner-warning">
        <p>@Model.WarningText</p>
    </div>

    @if (Model.KeyId is not null)
    {
        <dl class="fact-list">
            <dt>Device</dt><dd>@Model.DeviceName</dd>
            <dt>Fingerprint</dt><dd>@Model.Fingerprint</dd>
        </dl>
    }

    <form method="post"
          hx-post
          hx-page="Index"
          hx-page-handler="@Model.ConfirmHandler"
          hx-target="#result"
          hx-swap="innerHTML"
          hx-indicator="#spinner"
          hx-disabled-elt="find button[type='submit']">
        @Html.AntiForgeryToken()
        @if (Model.KeyId is not null)
        {
            <input type="hidden" name="keyId" value="@Model.KeyId" />
        }

        <div class="actions">
            <button type="submit" class="btn btn-primary">Confirm</button>
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('result').innerHTML = ''">
                Cancel
            </button>
        </div>
    </form>
</div>

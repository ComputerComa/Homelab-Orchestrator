@using HomelabOrchestrator.Services.Jobs
@model AnsibleRunJob

@functions {
    static string StageLabel(AnsibleRunStage stage) => stage switch
    {
        AnsibleRunStage.Queued => "Queued…",
        AnsibleRunStage.Running => "Running…",
        _ => "Working…",
    };
}

@if (Model.Stage == AnsibleRunStage.Succeeded)
{
    <div id="job-status" class="banner banner-success">
        <h2>Playbook finished</h2>
        <p><strong>@Model.Request.PlaybookName</strong> completed successfully (exit code @Model.ExitCode).</p>
        <pre class="run-output">@Model.Output</pre>
    </div>
}
else if (Model.Stage == AnsibleRunStage.Failed)
{
    <div id="job-status" class="banner banner-error">
        <h2>Playbook failed</h2>
        <p>@Model.Error</p>
        <pre class="run-output">@Model.Output</pre>
    </div>
}
else
{
    <div id="job-status" class="card"
         hx-get
         hx-page="Index"
         hx-page-handler="JobStatus"
         hx-route-jobId="@Model.Id"
         hx-trigger="load delay:1s"
         hx-target="#job-status"
         hx-swap="outerHTML">
        <h2>@StageLabel(Model.Stage)</h2>
        <p class="muted">Job <code>@Model.Id</code></p>
        @if (!string.IsNullOrEmpty(Model.Output))
        {
            <pre class="run-output">@Model.Output</pre>
        }
    </div>
}

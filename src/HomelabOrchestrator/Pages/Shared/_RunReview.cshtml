@using HomelabOrchestrator.Services.Ansible
@model RunFormModel

@{
    var (targetKind, targetValue) = Model.ParseTarget();
}

<div class="card">
    <h2>Run this playbook?</h2>

    <dl class="fact-list">
        <dt>Playbook</dt><dd>@Model.PlaybookName</dd>
        <dt>Target</dt><dd>@AnsibleRunTargetDescription.Describe(targetKind, targetValue)</dd>
    </dl>

    <form method="post"
          hx-post
          hx-page="Index"
          hx-page-handler="Run"
          hx-target="#result"
          hx-swap="innerHTML"
          hx-indicator="#spinner"
          hx-disabled-elt="find button[type='submit']">
        @Html.AntiForgeryToken()

        <input type="hidden" name="Form.PlaybookName" value="@Model.PlaybookName" />
        <input type="hidden" name="Form.Target" value="@Model.Target" />

        <div class="actions">
            <button type="submit" class="btn btn-primary">Confirm &amp; run</button>
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('result').innerHTML = ''">
                Cancel
            </button>
        </div>
    </form>
</div>

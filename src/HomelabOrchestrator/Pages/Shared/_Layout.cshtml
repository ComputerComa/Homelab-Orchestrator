<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Homelab Orchestrator")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://unpkg.com/htmx.org@2.0.10" defer></script>
</head>
<body>
    <header class="site-header">
        <h1>Homelab Orchestrator</h1>
        <p class="subtitle">Provision LXC containers on Proxmox VE</p>
        <nav class="site-nav">
            <a href="/" class="@(Context.Request.Path == "/" ? "active" : "")">Provision</a>
            <a href="/Runner" class="@(Context.Request.Path.StartsWithSegments("/Runner") ? "active" : "")">Ansible Runner</a>
        </nav>
    </header>
    <main class="container">
        @RenderBody()
    </main>
</body>
</html>

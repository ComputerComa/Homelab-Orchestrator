@model CreatedContainer

<div class="banner banner-success">
    <h2>Container created</h2>
    <p>
        <strong>@Model.Hostname</strong> (VMID @Model.Vmid) is up at
        <strong>@Model.IpAddress</strong>, built from <code>@Model.Template</code>
        in @Model.Duration.TotalSeconds.ToString("0.0")s.
    </p>
</div>
